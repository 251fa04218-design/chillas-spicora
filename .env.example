# CHILLA'S SPICORA - Environment Configuration
# Next.js, Supabase, Razorpay Configuration

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="CHILLA'S SPICORA"
NEXT_PUBLIC_BRAND_TAGLINE="THE ESSENCE OF INDIAN SPICES"
NEXT_PUBLIC_ORIGIN="Guntur, Andhra Pradesh, India"

# Database & Supabase (PostgreSQL)
